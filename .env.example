# Chartmeter credentials. Copy to .env and fill in. NEVER commit .env
# Any provider left blank is simply skipped by scripts/fetch_stats.py.

# Boomplay OpenAPI - https://developer.boomplay.com/ (partner approval required)
# Most relevant source for the East African market: official total_streams.
BOOMPLAY_APP_ID=
BOOMPLAY_APP_SECRET=

# YouTube Data API v3 - Google Cloud Console, enable the API, create a key.
# Free: 10,000 quota units/day; channels.list costs 1 unit per call.
YOUTUBE_API_KEY=

# Last.fm - https://www.last.fm/api/account/create (instant, free)
LASTFM_API_KEY=

# Spotify - https://developer.spotify.com/dashboard
# NOTE: gives followers + popularity only. Monthly listeners are NOT
# available from any official endpoint. See docs/06-data-sources.md
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# MusicBrainz needs no credentials.
